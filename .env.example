# Root site this app is mounted on (the app itself answers at /cv-app-v1, see next.config.mjs).
# Used for canonical / Open Graph URLs.
NEXT_PUBLIC_SITE_URL="https://ilijakosanin.dev"

# EmailJS (https://www.emailjs.com) credentials for the contact form.
# Without these the form shows an error instead of sending.
NEXT_PUBLIC_SERVICE_ID=""
NEXT_PUBLIC_TEMPLATE_ID=""
NEXT_PUBLIC_PUBLIC_KEY=""
